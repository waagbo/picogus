ISO-10303-21;
HEADER;
/* PicoGUS v1.3.2 TSSOP20-DIP20-300mil TSSOP-to-DIP adapter assembly (PCM5100A TSSOP-20 on the adapter PCB from
 * hw-tht-v1.3.2/adapters/TSSOP20-DIP20-300mil, 2 x 1x10 round machined pin strips under it).
 * Origin = DIP pin 1; z = 0 at the bottom of the FR-4, insulators from z -2.865 to -0.075.
 * Exported with kicad-cli pcb export step --no-dnp --user-origin 100x100mm
 * --include-pads --include-silkscreen --include-soldermask. The chip geometry is KiCad's
 * library model (CC-BY-SA 4.0 with the KiCad design exception); the rest: CERN-OHL-P v2. */
FILE_DESCRIPTION(('KiCad electronic assembly'),'2;1');
FILE_NAME('TSSOP20-DIP20-300mil-adapter.step','2026-10-31T14:48:34',(
    'Pcbnew'),('Kicad'),'Open CASCADE STEP processor 7.6',
  'KiCad to STEP converter','Unknown');
