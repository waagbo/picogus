				(thickness 0.01)
			)
			(layer "F.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 1"
				(type "core")
				(thickness 0.48)
				(material "FR4")
				(epsilon_r 4.5)
				(loss_tangent 0.02)
