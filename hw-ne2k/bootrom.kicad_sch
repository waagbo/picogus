	(text "BOOT ROM (option ROM for PXE / network disk-image boot)"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d107b1f0-22dc-59c1-bc11-b99856729b2c")
	)
	(text "SST39SF010A, 128 KB = 4 banks of 32 KB (bank = ROM_BANK1:0 from the Pico). 32 KB window at\nbase = 1 1 BASE2 BASE1 BASE0 (SA19..SA15): 001 C8000, 010 D0000, 011 D8000, 100 E0000, 101 E8000.\nROM_EN (pulled low = ROM invisible) and the base/bank bits are Pico GPIOs, set from the stored\nsettings right after reset, long before the BIOS scans for option ROMs.\nReads: ~SMEMR in the window -> flash OE, U15 drives the ISA data bus.\nWrites (flashing from DOS): only with jumper J2 fitted (SST command sequence at 5555h/2AAAh)."
		(exclude_from_sim no)
		(at 25.4 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ec34a4af-afa4-5868-80bd-1acd339086be")
	)
	(text "USB HOST (USB-A)"
		(exclude_from_sim no)
		(at 220.98 102.87 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4b3b29d1-b64b-5dfa-9fe0-9d24a5a7a0bb")
	)
	(text "Data straight from the Pico W test points TP3 (D+) / TP2 (D-), behind the Pico's own 27R\nseries resistors. VBUS from ISA +5V via F1 (0.5 A). Pico VBUS pin unused."
		(exclude_from_sim no)
		(at 220.98 106.68 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "a3700e4f-d9a1-59c0-b76f-422e56463828")
	)
