	(text "WT CONTROL (U12 = 74LVC2G06, open-drain inverters @ +3V3)"
		(exclude_from_sim no)
		(at 104.14 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5118ef27-efa2-58c4-9756-479d410b6e74")
	)
	(text "Both outputs are open drain with 10k pull-ups to +3V3, so the daughterboard never sees 5 V\non /RESET or MIDI (some DBs have 3.3 V inputs).\n/RESET: low while ISA RESET is high.  MIDI: same data as the MIDI-out jack (MPU-401 UART)."
		(exclude_from_sim no)
		(at 104.14 23.495 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "cbfdfd16-862b-5431-b93d-fad91a50c7dc")
	)
