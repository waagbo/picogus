	)
	(text "RV1 (dual 10k log) sets the WT level: pins 3/6 = CW end (signal), 1/4 = CCW end (GND).\nU11 sums PCM and WT at unity gain (inverting, 10k/10k) - no level loss, and the WT knob\ndoes not change the PCM level. C22/C23 (bipolar) block DC from the DB, R14/R15 keep them\ndischarged when no DB is fitted. Output: 100R, DC-coupled like v1.2."
		(exclude_from_sim no)
		(at 134.62 154.94 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "e3b14045-2071-5b63-95d1-2b0a32ad4c43")
	)
